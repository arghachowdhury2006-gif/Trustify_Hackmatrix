# Trustify Environment Variables
ENV=development
PORT=3000

# Base URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
APP_URL=http://localhost:3000

# Database Configuration (Optional for Vercel / Production persistence)
# Supports Neon Postgres, Supabase, or Vercel Postgres connection pool URL:
POSTGRES_URL=
DATABASE_URL=

# Scanner Settings
SCAN_TIMEOUT_MS=6000
MAX_REDIRECTS=8
ALLOW_PRIVATE_TARGETS=false

# Optional External API Keys (Leave blank for built-in heuristics and mock feeds)
GOOGLE_SAFE_BROWSING_KEY=
VIRUSTOTAL_API_KEY=
WHOIS_API_KEY=
